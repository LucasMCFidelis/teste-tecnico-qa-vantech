{
  "info": {
    "_postman_id": "90e0476a-e9a3-4ea1-bda0-260da5e9f894",
    "name": "vantech-test-qa-lucas-fidelis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36785755"
  },
  "item": [
    {
      "name": "GET health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Deve retornar status HTTP 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"O tempo de resposta deve ser inferior a 500ms\", () => {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(500);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"O status da aplicação deve ser 'ok'\", () => {\r",
              "    pm.expect(response.status).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"Deve conter um timestamp válido\", () => {\r",
              "    pm.expect(response).to.have.property(\"timestamp\");\r",
              "\r",
              "    const timestamp = Date.parse(response.timestamp);\r",
              "    pm.expect(timestamp).to.not.be.NaN;\r",
              "});\r",
              "\r",
              "pm.test(\"O serviço de banco de dados deve estar operacional\", () => {\r",
              "    pm.expect(response.services).to.have.property(\"database\");\r",
              "    pm.expect(response.services.database).to.eql(\"ok\");\r",
              "});\r",
              "\r",
              "pm.test(\"A estrutura da resposta deve estar correta\", () => {\r",
              "    pm.expect(response).to.have.all.keys([\r",
              "        \"status\",\r",
              "        \"timestamp\",\r",
              "        \"services\"\r",
              "    ]);\r",
              "\r",
              "    pm.expect(response.services).to.have.all.keys([\r",
              "        \"database\"\r",
              "    ]);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    }
  ]
}